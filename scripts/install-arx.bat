@echo off
REM ============================================================================
REM ARX CLI - Windows Installer (Adds to PATH automatically)
REM ============================================================================
REM Run as Administrator for system-wide install, or without for user install
REM After running, restart your terminal and type: arx
REM ============================================================================

setlocal enabledelayedexpansion

REM Colors
set GREEN=\x1b[32m
set BLUE=\x1b[34m
set YELLOW=\x1b[33m
set RED=\x1b[31m
set CYAN=\x1b[36m
set BOLD=\x1b[1m
set RESET=\x1b[0m

:print_banner
echo %CYAN%
echo  ╔═══════════════════════════════════════════╗
echo  ║         ARX CLI Installer v1.0.0         ║
echo  ╚═══════════════════════════════════════════╝
echo %RESET%

REM Check if running as Admin
net session >nul 2>&1
if %errorLevel% == 0 (
    set IS_ADMIN=1
    echo [%GREEN%OK%RESET%] Running as Administrator (system-wide install)
) else (
    set IS_ADMIN=0
    echo [%YELLOW%WARN%RESET%] Not running as Administrator (user install only)
    echo [%BLUE%INFO%RESET%] For system-wide install, right-click and "Run as Administrator"
)

echo.

REM Get project root (where this script is)
set "SCRIPT_DIR=%~dp0"
set "ROOT_DIR=%SCRIPT_DIR%.."
cd /d "%ROOT_DIR%"
set "ROOT_DIR=%CD%"

echo [%BLUE%INFO%RESET%] Project root: %ROOT_DIR%

REM Build if needed
if not exist "%ROOT_DIR%\frontend\dist\cli.js" (
    echo [%BLUE%INFO%RESET%] Frontend not built. Building...
    call scripts\arx.bat --build
    if errorlevel 1 (
        echo [%RED%ERROR%RESET%] Build failed
        pause
        exit /b 1
    )
)

if not exist "%ROOT_DIR%\engine\build\arx-engine.exe" (
    echo [%BLUE%INFO%RESET%] Engine not built. Building...
    call scripts\arx.bat --build
    if errorlevel 1 (
        echo [%RED%ERROR%RESET%] Build failed
        pause
        exit /b 1
    )
)

REM Determine install location
if %IS_ADMIN%==1 (
    set "INSTALL_DIR=C:\Program Files\arx"
    set "PATH_SCOPE=Machine"
    echo [%BLUE%INFO%RESET%] Installing to: %INSTALL_DIR% (system-wide)
) else (
    set "INSTALL_DIR=%LOCALAPPDATA%\arx"
    set "PATH_SCOPE=User"
    echo [%BLUE%INFO%RESET%] Installing to: %INSTALL_DIR% (user only)
)

echo [%BLUE%INFO%RESET%] Creating install directory...
if not exist "%INSTALL_DIR%" mkdir "%INSTALL_DIR%"

echo [%BLUE%INFO%RESET%] Copying engine...
copy /y "%ROOT_DIR%\engine\build\arx-engine.exe" "%INSTALL_DIR%\arx-engine.exe" >nul

echo [%BLUE%INFO%RESET%] Copying frontend...
if exist "%INSTALL_DIR%\frontend" rmdir /s /q "%INSTALL_DIR%\frontend"
xcopy /e /i /q "%ROOT_DIR%\frontend\dist" "%INSTALL_DIR%\frontend\dist"

echo [%BLUE%INFO%RESET%] Creating arx.cmd wrapper...
(
echo @echo off
echo REM ARX CLI Wrapper - Auto-generated by installer
echo set "ARX_ENGINE=%INSTALL_DIR%\arx-engine.exe"
echo set "ARX_FRONTEND=%INSTALL_DIR%\frontend\dist\cli.js"
echo.
echo REM Start engine if not running
echo tasklist /FI "IMAGENAME eq arx-engine.exe" 2^>NUL ^| find /I /N "arx-engine.exe"^>NUL
echo if "%%ERRORLEVEL%%"=="1" (
echo     start /B "" "%%ARX_ENGINE%%"
echo     timeout /t 1 /nobreak ^>NUL
echo )
echo.
echo node "%%ARX_FRONTEND%%" %%*
) > "%INSTALL_DIR%\arx.cmd"

echo [%BLUE%INFO%RESET%] Adding to PATH (%PATH_SCOPE%)...

REM Check if already in PATH
set "CURRENT_PATH="
for /f "tokens=2*" %%A in ('reg query "HKCU\Environment" /v Path 2^>nul') do set "CURRENT_PATH=%%B"
if "%IS_ADMIN%"=="1" (
    for /f "tokens=2*" %%A in ('reg query "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\Environment" /v Path 2^>nul') do set "CURRENT_PATH=%%B"
)

echo %CURRENT_PATH% | findstr /i /c:"%INSTALL_DIR%" >nul
if %errorLevel% == 0 (
    echo [%GREEN%OK%RESET%] Already in PATH
) else (
    if "%IS_ADMIN%"=="1" (
        setx /M Path "%CURRENT_PATH%;%INSTALL_DIR%" >nul
    ) else (
        setx Path "%CURRENT_PATH%;%INSTALL_DIR%" >nul
    )
    echo [%GREEN%OK%RESET%] Added %INSTALL_DIR% to %PATH_SCOPE% PATH
)

echo.
echo %BOLD%%GREEN%===========================================%RESET%
echo %BOLD%%GREEN%  INSTALLATION COMPLETE!%RESET%
echo %BOLD%%GREEN%===========================================%RESET%
echo.
echo Next steps:
echo 1. %BOLD%Close this terminal%RESET%
echo 2. %BOLD%Open a new CMD or PowerShell%RESET%
echo 3. Type: %CYAN%arx%RESET%
echo.
echo The TUI will launch automatically!
echo.
echo To uninstall later, run: %CYAN%uninstall-arx.bat%RESET%
echo.

pause