{
  "name": "@arx-cli/frontend",
  "version": "1.0.0",
  "description": "ARX Frontend - Beautiful React/Ink TUI for the ARX AI Agent",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "arx": "./dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arx-cli/arx-cli.git",
    "directory": "frontend"
  },
  "homepage": "https://github.com/arx-cli/arx-cli#readme",
  "bugs": {
    "url": "https://github.com/arx-cli/arx-cli/issues"
  },
  "scripts": {
    "dev": "tsx watch src/cli.tsx",
    "build": "tsc && esbuild src/cli.tsx --bundle --platform=node --outfile=dist/cli.js --external:@arx/engine",
    "start": "node dist/cli.js",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "ink": "^5.0.0",
    "ink-big-text": "^2.0.0",
    "ink-gradient": "^3.0.0",
    "ink-spinner": "^6.0.0",
    "ink-text-input": "^6.0.0",
    "ink-select-input": "^6.0.0",
    "ink-markdown": "^2.0.0",
    "react": "^18.2.0",
    "chalk": "^5.3.0",
    "cli-spinners": "^2.9.0",
    "gradient-string": "^2.0.2",
    "lucide-react": "^0.400.0",
    "framer-motion": "^11.0.0",
    "zustand": "^4.5.0",
    "uuid": "^10.0.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "@types/js-yaml": "^4.0.0",
    "typescript": "^5.4.0",
    "tsx": "^4.7.0",
    "esbuild": "^0.20.0",
    "eslint": "^8.57.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}