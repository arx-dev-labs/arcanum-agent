{
    "name":  "@arx-cli/frontend",
    "version":  "1.0.0",
    "description":  "ARX Frontend - Beautiful React/Ink TUI for the ARX AI Agent",
    "type":  "module",
    "main":  "dist/index.js",
    "bin":  {
                "arx":  "./dist/cli.js"
            },
    "repository":  {
                       "type":  "git",
                       "url":  "https://github.com/arx-cli/arx-cli.git",
                       "directory":  "frontend"
                   },
    "homepage":  "https://github.com/arx-cli/arx-cli#readme",
    "bugs":  {
                 "url":  "https://github.com/arx-cli/arx-cli/issues"
             },
    "scripts":  {
                    "dev":  "tsx watch src/cli.tsx",
                    "build":  "tsc \u0026\u0026 esbuild src/cli.tsx --bundle --platform=node --format=esm --outfile=dist/cli.js",
                    "start":  "node dist/cli.js",
                    "lint":  "tsc --noEmit",
                    "typecheck":  "tsc --noEmit",
                    "test":  "vitest run"
                },
    "dependencies":  {
                         "chalk":  "^5.3.0",
                         "cli-spinners":  "^2.9.0",
                         "framer-motion":  "^11.0.0",
                         "gradient-string":  "^2.0.2",
                         "ink":  "^5.0.0",
                         "ink-big-text":  "^2.0.0",
                         "ink-gradient":  "^3.0.0",
                         "ink-markdown":  "^1.0.4",
                         "ink-select-input":  "^6.2.0",
                         "ink-spinner":  "^5.0.0",
                         "ink-text-input":  "^6.0.0",
                         "js-yaml":  "^4.1.0",
                         "lucide-react":  "^0.400.0",
                         "react":  "^18.2.0",
                         "react-devtools-core":  "^4.28.5",
                         "uuid":  "^10.0.0",
                         "zustand":  "^4.5.0"
                     },
    "devDependencies":  {
                            "@types/js-yaml":  "^4.0.0",
                            "@types/node":  "^20.0.0",
                            "@types/react":  "^18.2.0",
                            "@types/uuid":  "^9.0.0",
                            "esbuild":  "^0.20.0",
                            "eslint":  "^8.57.0",
                            "tsx":  "^4.7.0",
                            "typescript":  "^5.4.0",
                            "vitest":  "^1.0.0"
                        },
    "engines":  {
                    "node":  "\u003e=20.0.0"
                },
    "publishConfig":  {
                          "access":  "public"
                      }
}